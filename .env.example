# ============ 必填项（缺失或留空将阻断启动） ============
# 管理员登录密码（务必改为强口令）
ADMIN_PASSWORD=
# 管理员 JWT 签名密钥（务必改为随机字符串，可用 `openssl rand -hex 32` 生成）
JWT_SECRET=

# ============ 可选项（留空使用默认值） ============
# 后端服务端口（默认 3001）
PORT=3001
# 前端开发端口（vite，默认 5173）
VITE_PORT=5173
# Docker 部署对外端口（默认 15000）
DOCKER_PORT=15000
# 上传分片大小（MB，默认 5）
CHUNK_SIZE=5
# 视频单文件大小上限（MB，默认 100）
VIDEO_MAX_SIZE_MB=100
# 数据存储目录：本地开发留空即使用项目内 ./data；
# Docker 部署由 docker-compose 注入 /app/data，无需在此配置
# DATA_DIR=/app/data